# Python
__pycache__/
*.pyc

# PyInstaller build artifacts -- regenerate with the command in PROCESSO_OCR.md
build/
dist/

# Claude Code local environment state (settings, caches) -- but agent
# definitions under .claude/agents/ are part of the project, keep those tracked
.claude/*
!.claude/agents/
!.claude/agents/**

# Captures folder is mostly ad-hoc test data from this session; keep only
# the real BIOS photo fixtures that test_selection.py depends on
# (AMI: 20260803-1543*, horizontal tab strip; Positivo: positivo_*, vertical
# sidebar -- see ESTUDO_SELECAO.md for why both models are fixtures), plus
# the frames the OCR engine benchmark reports numbers against: a study
# whose evidence image is not in the repo cannot be re-run or checked
# (see docs/studies/estudo-motores-ocr.md).
captures/*
!captures/20260803-1543*
!captures/positivo_*
!captures/*_bench_live.png

# Ad-hoc debug output accumulated during development (logs, one-off dumps)
*_log*.txt
*.log
camera_test*
camera_index_*.png
droidcam_page.html
ocr_check*.json
ocr_with_selection.json
final_check.json
out.json

# Perception contracts cached by test_biostools.py (regenerated on demand)
.biostools_cache/

# Where explore_setting found things, per machine -- NOT the reviewed
# tour output (that is data/label_index.json, which IS committed). See
# biostools/discovered.py's module docstring for why the two must never
# share a file.
data/discovered_settings.json
